# Local scratch space
work/
tmp/
temp/

# EDA build outputs
build/
runs/
logs/
reports/
objects/
cache/
.cache/

# OpenROAD / physical design artifacts
*.odb
*.db
*.def
*.lef
*.gds
*.gdsii
*.spef
*.sdf
*.sdc.out
*.vcd
